# Keycloak Configuration
# Copy this file to .env.local and fill in your values

# Keycloak server URL (without trailing slash)
KEYCLOAK_URL=http://localhost:8080

# Keycloak realm name
KEYCLOAK_REALM=master

# OAuth Client ID (must be a confidential client for SSR)
KEYCLOAK_CLIENT_ID=my-app

# OAuth Client Secret (from Keycloak client credentials)
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# Auth.js / NextAuth Configuration
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET=your-random-secret-here

# Your application URL (used for OAuth callbacks)
NEXTAUTH_URL=http://localhost:3000

# Optional: Auth.js debug mode (set to true for troubleshooting)
# AUTH_DEBUG=false
